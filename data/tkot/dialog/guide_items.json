    "text": "道具一览"
  },
  "can_close_with_escape": true,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "【开局必给】",
        "color": "gold",
        "bold": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "永恒之驽：弩，箭类道具都要用它射出去。"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "金色胡萝卜 ×5：回饱食度，可堆叠 99。"
