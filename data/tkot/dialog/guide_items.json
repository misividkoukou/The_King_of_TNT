    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "治疗池：放下一个治疗云，站在里面回血。冷却 5 秒。",
        "color": "aqua"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "地雷：放在地上 1 秒后激活，踩上就炸。",
        "color": "red"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "低当量爆炸箭 / 大当量爆炸箭：射中后爆炸，威力不同。",
        "color": "aqua"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "传送箭：射出去落地后，把自己传到落点。",
        "color": "light_purple"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "风弹：原版风弹，能把人吹飞。",
        "color": "aqua"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "击退棒：击退 I，把人打飞。",
        "color": "gold"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "末影珍珠：冷却降到 0.5 秒的版本。",
        "color": "light_purple"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": " "
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "【地图专属】",
        "color": "gold",
        "bold": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "腐朽文明 / 洞穴：额外发 5 支传送箭；洞穴再额外发 5 颗末影珍珠。"
      }
    }
  ],
  "action": {
    "label": {
      "text": "← 返回主菜单"
