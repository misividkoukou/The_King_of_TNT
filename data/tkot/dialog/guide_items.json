    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": " "
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "【普通物资（开局抽一次 + 战斗中每 3 秒补给）】",
        "color": "gold",
        "bold": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "抛射型tnt：吃下即向正前方抛出一颗 TNT，引信 3 秒。冷却 0.5 秒。"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": " "
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "【特殊物资（每 15 秒抽奖 / 特殊道具事件）】",
        "color": "gold",
        "bold": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "瞬爆型tnt：碰到地面立刻爆炸。冷却 2 秒。",
        "color": "aqua"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "多重射击tnt：一次抛出 3 颗，呈扇形散开。冷却 1 秒。",
        "color": "aqua"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "弹跳tnt：落地会弹起，最多弹 3 次后才爆炸。冷却 1 秒。",
        "color": "aqua"
      }
